// Cloudflare Workers static-assets config (Workers Builds: build `npm run build`, deploy `npx wrangler deploy`).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oskaruddenberg",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
